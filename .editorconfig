# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4
tab_width = 4
insert_final_newline = true
trim_trailing_whitespace = true

# YAML does not allow tab indentation (spec), so it is the only exception.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Trailing double spaces are meaningful line breaks in Markdown.
[*.md]
trim_trailing_whitespace = false
