{
	"name": "project-alpha",
	"version": "0.0.7",
	"private": true,
	"type": "module",
	"description": "Dark fantasy roguelite deckbuilder with RPG progression, in pixel art, for the web.",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview --port 4173 --strictPort",
		"typecheck": "tsc --noEmit",
		"check": "tsc --noEmit",
		"test": "bun test tests/unit",
		"test:unit": "bun test tests/unit",
		"test:smoke": "playwright test tests/smoke",
		"test:e2e": "playwright test tests/e2e",
		"sim": "bun scripts/sim.ts",
		"lint": "biome ci .",
		"format": "biome check --write .",
		"lint:md": "markdownlint-cli2 \"**/*.md\"",
		"changelog": "git-cliff --config cliff.toml --output CHANGELOG.md",
		"ci": "bun scripts/ci.ts",
		"release": "bun scripts/release.ts",
		"prepare": "husky",
		"desktop:dev": "bun run build && electron .",
		"desktop:build": "bun run build && electron-builder --win portable",
		"android:sync": "bun run build && cap sync android",
		"android:build": "bun run android:sync && cd android && ./gradlew.bat assembleDebug"
	},
	"dependencies": {
		"@capacitor/android": "8.5.3",
		"@capacitor/core": "8.5.3",
		"phaser": "4.2.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@capacitor/cli": "8.5.3",
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@playwright/test": "1.64.1",
		"@types/bun": "1.4.4",
		"electron": "45.0.0",
		"electron-builder": "26.18.0",
		"git-cliff": "2.14.2",
		"husky": "9.1.7",
		"markdownlint-cli2": "0.24.0",
		"typescript": "7.0.2",
		"vite": "8.3.5"
	},
	"main": "electron/main.cjs",
	"build": {
		"appId": "xyz.lekzera.ossuary",
		"productName": "Ossuary",
		"directories": {
			"output": "release"
		},
		"files": [
			"dist/**/*",
			"electron/**/*"
		],
		"win": {
			"target": [
				"portable"
			],
			"icon": "electron/icon.png"
		}
	}
}
