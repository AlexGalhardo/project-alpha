{
	"name": "project-alpha",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "Dark fantasy roguelite deckbuilder with RPG progression, in pixel art, for the web.",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview --port 4173 --strictPort",
		"typecheck": "bun check",
		"lint": "biome ci .",
		"format": "biome check --write .",
		"lint:md": "markdownlint-cli2 \"**/*.md\"",
		"changelog": "git-cliff --config cliff.toml --output CHANGELOG.md",
		"ci": "bun scripts/ci.ts",
		"release": "bun scripts/release.ts",
		"prepare": "husky"
	},
	"dependencies": {
		"phaser": "4.2.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@playwright/test": "1.64.1",
		"@types/bun": "1.4.4",
		"git-cliff": "2.14.2",
		"husky": "9.1.7",
		"markdownlint-cli2": "0.24.0",
		"typescript": "7.0.2",
		"vite": "8.3.5"
	}
}
